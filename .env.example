# ============================================
# LeadFlow CRM - Variáveis de Ambiente
# ============================================

# App
APP_NAME=LeadFlow
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_PORT=8000

# Database
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=leadflow

# Google APIs
GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_CALENDAR_API_KEY=your-google-calendar-key

# Instagram (via Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=your-instagram-token
INSTAGRAM_BUSINESS_ID=your-business-id

# LinkedIn (via RapidAPI ou proxy)
LINKEDIN_API_KEY=your-linkedin-key

# Receita Federal (via BrasilAPI ou CNPJ.ws)
CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
